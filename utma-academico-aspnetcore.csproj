<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>utma_academico</RootNamespace>
    <AssemblyName>utma-academico</AssemblyName>
    <!-- Generate XML doc file for Swagger UI -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress warnings about missing XML comments on public members -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>102658e8-52e8-4593-8931-eaa21ece424b</UserSecretsId>
  </PropertyGroup>

  <!-- Exclude tests folder, scripts and temp projects from being compiled in the main project -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="scripts\**\*.cs" />
    <Compile Remove="TempBcryptGen\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

</Project>
